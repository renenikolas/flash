# Kopieren nach .env.local und ausfüllen. .env.local wird nie committet.

# --- Öffentlich (landet im Browser-Bundle) ---
# Supabase Dashboard → Project Settings → API Keys (Publishable key, sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Nur Server. Niemals mit NEXT_PUBLIC_-Präfix! ---
GOINGELECTRIC_API_KEY=
# Base-URL und Key bekommst du von Ecurious
ECURIOUS_BASE_URL=
ECURIOUS_API_KEY=
# Optional: Lock, der zum Demo-Stellplatz gehört. Leer = erster Lock aus GET /api/v1/locks.
ECURIOUS_LOCK_ID=

# true = feste Beispieldaten statt echter Hardware (ein Lock, vacant, raised)
ECURIOUS_MOCK=false
# Hardware-Befehle (Bügel heben/senken, keep-state, Whitelist). Standardmäßig aus.
ECURIOUS_COMMANDS_ENABLED=false
# Pflicht, sobald Befehle an sind. Die Admin-Buttons fragen danach.
FLASH_ADMIN_TOKEN=
